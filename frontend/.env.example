# Next.js Configuration
NEXT_PUBLIC_APP_NAME=FreelanceDAO
NEXT_PUBLIC_APP_DESCRIPTION=Decentralized Freelancing Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Blockchain Configuration
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY

# Smart Contract Addresses (Set after deployment)
NEXT_PUBLIC_GOVERNANCE_TOKEN_CONTRACT=
NEXT_PUBLIC_USER_REGISTRY_CONTRACT=
NEXT_PUBLIC_ESCROW_MANAGER_CONTRACT=
NEXT_PUBLIC_DISPUTE_RESOLUTION_CONTRACT=
NEXT_PUBLIC_FREELANCE_JOB_CONTRACT=

# Wallet Connect Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Social Media Links
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/freelancedao
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/freelancedao
NEXT_PUBLIC_GITHUB_URL=https://github.com/freelancedao

# Support Configuration
NEXT_PUBLIC_SUPPORT_EMAIL=support@freelancedao.com
NEXT_PUBLIC_DOCS_URL=https://docs.freelancedao.com
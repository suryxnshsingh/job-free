# =================================================================
# BLOCKCHAIN FREELANCING PLATFORM - ENVIRONMENT CONFIGURATION
# =================================================================

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/freelance_platform"
DIRECT_URL="postgresql://username:password@localhost:5432/freelance_platform"

# =================================================================
# REDIS CONFIGURATION  
# =================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# =================================================================
# JWT CONFIGURATION
# =================================================================
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-characters-long"

# =================================================================
# BLOCKCHAIN CONFIGURATION
# =================================================================
# Ethereum Mainnet
ETHEREUM_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-alchemy-key"
ETHEREUM_WS_URL="wss://eth-mainnet.g.alchemy.com/v2/your-alchemy-key"

# Polygon Mainnet
POLYGON_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key"
POLYGON_WS_URL="wss://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key"

# Sepolia Testnet (for development)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key"
SEPOLIA_WS_URL="wss://eth-sepolia.g.alchemy.com/v2/your-alchemy-key"

# =================================================================
# CONTRACT ADDRESSES (Populated after deployment)
# =================================================================
FREELANCE_JOB_CONTRACT=""
ESCROW_MANAGER_CONTRACT=""
USER_REGISTRY_CONTRACT=""
DISPUTE_RESOLUTION_CONTRACT=""
GOVERNANCE_TOKEN_CONTRACT=""

# =================================================================
# IPFS CONFIGURATION
# =================================================================
# Infura IPFS
IPFS_URL="https://ipfs.infura.io:5001/api/v0"
IPFS_PROJECT_ID="your-infura-ipfs-project-id"
IPFS_PROJECT_SECRET="your-infura-ipfs-project-secret"

# Pinata IPFS (Alternative/Backup)
PINATA_API_KEY="your-pinata-api-key"
PINATA_SECRET_API_KEY="your-pinata-secret-api-key"
PINATA_JWT="your-pinata-jwt-token"

# IPFS Gateway
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# =================================================================
# MONITORING & ANALYTICS
# =================================================================
# Sentry (Error Tracking)
SENTRY_DSN="your-sentry-dsn-url"

# Mixpanel (Analytics)
MIXPANEL_TOKEN="your-mixpanel-token"

# =================================================================
# EMAIL CONFIGURATION
# =================================================================
# SendGrid
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@freelancedao.com"

# =================================================================
# DEPLOYMENT KEYS (NEVER COMMIT THESE TO VERSION CONTROL)
# =================================================================
# Private key for contract deployment (without 0x prefix)
PRIVATE_KEY=""
DEPLOYER_PRIVATE_KEY=""

# =================================================================
# API KEYS
# =================================================================
# Etherscan/Block Explorer API Keys
ETHERSCAN_API_KEY="your-etherscan-api-key"
POLYGONSCAN_API_KEY="your-polygonscan-api-key"

# CoinGecko API (for price feeds)
COINGECKO_API_KEY="your-coingecko-api-key"

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET="your-session-secret-minimum-32-characters"
SESSION_SECURE="false"  # Set to "true" in production with HTTPS

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://freelancedao.com"

# =================================================================
# FILE UPLOAD CONFIGURATION
# =================================================================
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,text/plain"

# =================================================================
# NOTIFICATION CONFIGURATION
# =================================================================
# Slack Webhook (for alerts)
SLACK_WEBHOOK_URL="your-slack-webhook-url"

# Discord Webhook (alternative)
DISCORD_WEBHOOK_URL="your-discord-webhook-url"

# =================================================================
# DEVELOPMENT TOOLS
# =================================================================
# Enable debug logging
DEBUG="freelance:*"

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# =================================================================
# TESTING CONFIGURATION
# =================================================================
TEST_DATABASE_URL="postgresql://test:test@localhost:5433/test_freelance_platform"
TEST_REDIS_URL="redis://localhost:6380"

# =================================================================
# PRODUCTION OVERRIDES
# =================================================================
# These should be set differently in production

# Production Database (use managed database service)
# DATABASE_URL="postgresql://prod_user:secure_password@prod-db.amazonaws.com:5432/freelance_platform"

# Production Redis (use managed Redis service)
# REDIS_URL="rediss://username:password@prod-redis.amazonaws.com:6380"

# Production CORS (restrict to production domains)
# CORS_ORIGINS="https://freelancedao.com,https://app.freelancedao.com"

# Production Security
# SESSION_SECURE="true"
# NODE_ENV="production"

# =================================================================
# FEATURE FLAGS
# =================================================================
ENABLE_ANALYTICS="true"
ENABLE_PUSH_NOTIFICATIONS="false"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_DISCORD_INTEGRATION="false"
ENABLE_ADVANCED_SEARCH="true"

# =================================================================
# CACHE CONFIGURATION
# =================================================================
CACHE_TTL=3600  # 1 hour in seconds
CACHE_MAX_SIZE=1000  # Maximum number of cached items

# =================================================================
# BACKUP CONFIGURATION
# =================================================================
BACKUP_FREQUENCY="daily"  # daily, weekly, monthly
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH="/backups"

# =================================================================
# NOTES
# =================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env files to version control
# 3. Use different values for development, staging, and production
# 4. Rotate secrets regularly
# 5. Use environment-specific configuration management in production
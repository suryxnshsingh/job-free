# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/freelancedao_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/freelancedao_dev"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-for-development-only-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-for-development-only-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Blockchain Configuration (Using public endpoints for development)
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon.llamarpc.com
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io
BLOCKCHAIN_PRIVATE_KEY=

# Smart Contract Addresses (Will be set after deployment)
GOVERNANCE_TOKEN_CONTRACT=
USER_REGISTRY_CONTRACT=
ESCROW_MANAGER_CONTRACT=
DISPUTE_RESOLUTION_CONTRACT=
FREELANCE_JOB_CONTRACT=

# IPFS Configuration (Mock for development)
IPFS_URL=https://ipfs.infura.io:5001/api/v0
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Email Configuration (Development - logs to console)
FROM_EMAIL=noreply@freelancedao.local
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain
UPLOAD_DIR=uploads

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Security Configuration
SESSION_SECRET=dev-session-secret-key
SESSION_SECURE=false
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000

# Analytics Configuration (Disabled for development)
MIXPANEL_TOKEN=
SENTRY_DSN=
ENABLE_ANALYTICS=false

# Notification Configuration
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# Feature Flags
ENABLE_ADVANCED_SEARCH=true
ENABLE_DISCORD_INTEGRATION=false
ENABLE_VOICE_CHAT=false
ENABLE_TIME_TRACKING=true
ENABLE_ESCROWLESS_PAYMENTS=false

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Backup Configuration
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/tmp/backups

# Logging Configuration
LOG_LEVEL=debug
ENABLE_HTTP_LOGGING=true
ENABLE_DATABASE_LOGGING=true
# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/freelancedao_dev"
DIRECT_URL="postgresql://username:password@localhost:5432/freelancedao_dev"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
BLOCKCHAIN_PRIVATE_KEY=0x1234567890abcdef... # Optional for automated transactions

# Smart Contract Addresses (Set after deployment)
GOVERNANCE_TOKEN_CONTRACT=
USER_REGISTRY_CONTRACT=
ESCROW_MANAGER_CONTRACT=
DISPUTE_RESOLUTION_CONTRACT=
FREELANCE_JOB_CONTRACT=

# IPFS Configuration
IPFS_URL=https://ipfs.infura.io:5001/api/v0
IPFS_PROJECT_ID=your-ipfs-project-id
IPFS_PROJECT_SECRET=your-ipfs-project-secret
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-key

# Email Configuration (Choose one)
FROM_EMAIL=noreply@freelancedao.com

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Or SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain
UPLOAD_DIR=uploads

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Security Configuration
SESSION_SECRET=your-session-secret-key
SESSION_SECURE=false
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000

# Analytics Configuration (Optional)
MIXPANEL_TOKEN=your-mixpanel-token
SENTRY_DSN=your-sentry-dsn
ENABLE_ANALYTICS=false

# Notification Configuration
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false

# Feature Flags
ENABLE_ADVANCED_SEARCH=true
ENABLE_DISCORD_INTEGRATION=false
ENABLE_VOICE_CHAT=false
ENABLE_TIME_TRACKING=true
ENABLE_ESCROWLESS_PAYMENTS=false

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Backup Configuration
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Logging Configuration
LOG_LEVEL=info
ENABLE_HTTP_LOGGING=true
ENABLE_DATABASE_LOGGING=false